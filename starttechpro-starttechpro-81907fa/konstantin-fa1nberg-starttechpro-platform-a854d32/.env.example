# ============================================
# StartTechPro Ecosystem — Environment Variables
# ============================================

# --- Supabase (Backend) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM Providers ---
# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_ORG_ID=your-org-id

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# YandexGPT
YANDEXGPT_API_KEY=your-yandexgpt-key
YANDEXGPT_FOLDER_ID=your-folder-id

# --- Vercel (Deployment) ---
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id

# --- YooKassa (Payments) ---
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_PLATFORM_ACCOUNT=your-platform-account-id  # Для Split Payments

# --- Email (Transactional) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@starttechpro.ru
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@starttechpro.ru

# --- Monitoring ---
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ORG=starttechpro
SENTRY_PROJECT=ecosystem

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=your-posthpg-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Security ---
JWT_SECRET=your-jwt-secret
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=https://starttechpro.ru

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_AI_AGENTS=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_BLOG=true

# --- Domain Registration (Reg.ru / Nic.ru / Cloudflare) ---
DOMAIN_REGISTRAR_API_KEY=your-registrar-api-key
DOMAIN_REGISTRAR_PROVIDER=regru  # regru | nicru | cloudflare
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# --- Diadoc / SBIS (EDF Documents) ---
DIADOC_API_KEY=your-diadoc-api-key
DIADOC_ORG_ID=your-diadoc-org-id
SBIS_API_KEY=your-sbis-api-key